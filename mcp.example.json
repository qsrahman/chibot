{
  "mcpServers": {
    "files": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/Documents"
      ]
    },
    "tracker": {
      "type": "remote",
      "url": "http://localhost:8808/mcp",
      "headers": { "Authorization": "Bearer ${TRACKER_TOKEN}" },
      "ask": true,
      "disabledTools": ["delete_issue"],
      "startupTimeoutSec": 20,
      "toolTimeoutSec": 120,
      "instructions": true
    }
  }
}
