{
  "name": "chibot",
  "version": "0.17.3",
  "description": "Local ChatGPT-style chatbot on the OpenAI Responses API",
  "private": true,
  "bin": {
    "chibot": "src/server/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "node --watch src/server/cli.ts --port 3000 --no-open",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/cli.ts",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web && tsc --noEmit -p tests/e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "seed:perf": "node scripts/seed-perf.ts",
    "measure:chat": "node scripts/measure-chat.ts",
    "release": "node scripts/release.ts"
  },
  "author": "Qazi Sami ur Rahman <qsrahmans@gmail.com>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.21",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dependency-cruiser": "^18.7.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@mozilla/readability": "0.6.0",
    "env-paths": "^4.0.0",
    "eventsource-parser": "^4.1.3",
    "hast-util-to-text": "^4.0.3",
    "hono": "^4.13.18",
    "katex": "^0.19.1",
    "linkedom": "0.18.15",
    "lucide-react": "^1.67.0",
    "mammoth": "1.13.0",
    "openai": "^7.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sqlite-vec": "0.1.9",
    "tinykeys": "^4.0.1",
    "unpdf": "2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
