{
  "name": "chibot",
  "version": "0.1.0",
  "description": "Local ChatGPT-style chatbot on the OpenAI Responses API",
  "main": "src/server/main.ts",
  "private": true,
  "bin": {
    "chibot": "src/server/main.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "files": [
    "src",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [],
  "author": "Qazi Sami ur Rahman <qsrahmans@gmail.com>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "openai": "^7.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
