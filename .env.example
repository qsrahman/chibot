# Copy to .env and fill in.
# OpenAI:
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# Or any OpenAI-compatible Responses API server (key optional):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=gemma4:cloud
# Image generation: an image model (not a chat model); defaults to the chat
# endpoint (gpt-image-2 on OpenAI). With chat on Ollama, use OpenAI here:
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# Project file search by meaning; defaults to the chat endpoint
# (text-embedding-3-small on OpenAI). With Ollama: nomic-embed-text.
# OPENAI_EMBEDDING_MODEL=
# Web search (Brave Search API):
# BRAVE_API_KEY=
# HOST=127.0.0.1
# PORT=3000
